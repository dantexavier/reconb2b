# Postgres connection (Vercel Postgres / Neon)
DATABASE_URL=postgres://user:password@host:5432/reconos

# Session cookies are marked Secure when NODE_ENV=production (set automatically by Vercel)
NODE_ENV=development

# Twilio SMS (leave MOCK_SMS=true to log messages to the console instead of sending)
MOCK_SMS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel sets this automatically for Cron requests once you add it as a
# project env var — the approval-escalation cron checks for a matching
# Authorization: Bearer header. Leave unset for local dev (endpoint runs
# unauthenticated with a console warning).
CRON_SECRET=
