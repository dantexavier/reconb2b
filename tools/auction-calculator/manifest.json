{
  "manifest_version": 3,
  "name": "Auction Max-Buy Calculator",
  "version": "2.0.0",
  "description": "Floating calculator for appraising vehicles at online auctions: max purchase price from JD Power, market value and days supply.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle Max-Buy Calculator (Alt+Shift+A)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-calculator": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Show / hide the calculator"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.manheim.com/*",
        "https://*.adesa.com/*",
        "https://*.openlane.com/*",
        "https://*.acvauctions.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
