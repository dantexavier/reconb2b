{
  "manifest_version": 3,
  "name": "Auction Max-Buy Calculator",
  "version": "1.2.0",
  "description": "Floating, semi-transparent calculator for appraising vehicles on online auctions.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle Max-Buy Calculator (Alt+Shift+A)" },
  "commands": {
    "toggle-calculator": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Show / hide the calculator"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
